{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zMail",
  "version": "0.1.7",
  "identifier": "com.zach.zmail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "zMail",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https:",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https:",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost blob:",
        "frame-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' https:",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https:",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: ws://localhost:1420 http://localhost:1420",
        "frame-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/Assets.car",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QzkyRDYyMkFGRUM4MDgKUldRSXlQNHFZaTNKaVp4VDhGR0NLalRWTitPN05nbHlLTXFMUDlWQkprb2pLR3hIRjh0WGhjb2IK",
      "endpoints": ["https://github.com/umzcio/zMail/releases/latest/download/latest.json"]
    }
  }
}