{
  "name": "zmail",
  "private": true,
  "version": "0.1.7",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "sh scripts/build-icon.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 108",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && cd src-tauri && cargo test && cargo clippy --all-targets -- -D warnings",
    "audit": "pnpm audit --prod && cd src-tauri && cargo audit",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "3.13.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.54.0",
    "marked": "18.0.14",
    "motion": "^14.1.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
